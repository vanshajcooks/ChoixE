# CampusConnect Environment Variables Template
# Copy this file to .env and adjust values for your local environment.
# Never commit real credentials to source control.

# Database Configuration
DB_URL=jdbc:mysql://localhost:3306/campusconnect?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC
DB_USERNAME=campusconnect
DB_PASSWORD=your_secure_password_here

# Server Configuration
SERVER_PORT=8080
